#!/bin/bash
# bin/compile <build-dir> <cache-dir>

set -e

BUILD_DIR=$1
CACHE_DIR=$2

indent() {
  sed -u 's/^/       /'
}

arrow() {
  sed -u 's/^/-----> /'
}

GS_VERSION="10.08.0"
echo "Installing Ghostscript $GS_VERSION using build directory $BUILD_DIR" | arrow

GS_VENDOR="$BUILD_DIR/vendor/ghostscript"
GS_CACHE="$CACHE_DIR/ghostscript-$GS_VERSION"

# Use cached build if available
if [ -f "$GS_CACHE/bin/gs" ]; then
  echo "Using cached Ghostscript $GS_VERSION build" | indent
else
  echo "Fetching Ghostscript $GS_VERSION source" | indent
  PACKAGE="https://github.com/ArtifexSoftware/ghostpdl-downloads/releases/download/gs${GS_VERSION//./}/ghostscript-$GS_VERSION.tar.gz"

  GS_BUILD_DIR=$(mktemp -d)
  curl -sL $PACKAGE | tar xzf - -C $GS_BUILD_DIR 2>&1 | indent

  echo "Compiling Ghostscript $GS_VERSION (this may take a few minutes)" | indent
  cd "$GS_BUILD_DIR/ghostscript-$GS_VERSION"
  ./configure --prefix="$GS_CACHE" --disable-cups --disable-gtk --without-x 2>&1 | indent
  make -j$(nproc) 2>&1 | indent
  make install 2>&1 | indent

  cd /
  rm -rf $GS_BUILD_DIR
fi

# Install into build dir
rm -rf $GS_VENDOR
mkdir -p $GS_VENDOR
cp -R $GS_CACHE/* $GS_VENDOR/

mkdir -p $BUILD_DIR/bin
cp $GS_VENDOR/bin/gs $BUILD_DIR/bin/

echo "Setting up ghostscript environment" | indent
mkdir -p $BUILD_DIR/.profile.d
PROFILE_PATH="$BUILD_DIR/.profile.d/ghostscript.sh"
cat > $PROFILE_PATH <<'PROFILE'
export PATH="$HOME/vendor/ghostscript/bin:$HOME/bin:$PATH"
export LD_LIBRARY_PATH="$HOME/vendor/ghostscript/lib:$LD_LIBRARY_PATH"
PROFILE
